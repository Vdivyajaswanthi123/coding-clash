# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/coding-clash-arena

# --- JWT ---
# Generate a strong secret, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRE=7d

# --- OpenAI ---
# Required for the AI judge. Without it the judge falls back to a heuristic score.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
CLIENT_URL=http://localhost:3000
